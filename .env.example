# Never use default secrets in production. Example values only.
APP_ENV=development
SECRET_KEY=local-development-only-change-me
DATABASE_URL=sqlite:///./yorumpilot.db
FRONTEND_URL=http://localhost:3000
GOOGLE_MODE=mock
BACKEND_INTERNAL_URL=http://localhost:8000

# Optional NVIDIA draft generation; no external calls without both settings
AI_PROVIDER=rules
NVIDIA_MODEL=openai/gpt-oss-20b
# NVIDIA_API_KEY=keep-only-in-private-server-environment

# BotFather'dan alınan token SADECE Render API ortamında tutulur.
# TELEGRAM_BOT_TOKEN=SET_ONLY_AS_PRIVATE_RENDER_ENVIRONMENT_VARIABLE
